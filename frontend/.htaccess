# ============================================
# AstrNest Apache 部署配置
# 用于单页应用（SPA）的 URL 重写和性能优化
# ============================================

# 启用重写引擎
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 强制 HTTPS（生产环境建议启用）
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # 如果请求的是真实文件或目录，直接访问
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 静态资源缓存优化
    RewriteCond %{REQUEST_URI} \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webp)$ [NC]
    RewriteRule ^ - [L]

    # 所有其他请求重写到 index.html（支持前端路由）
    RewriteRule ^ index.html [L]
</IfModule>

# ============================================
# 安全响应头配置
# ============================================
<IfModule mod_headers.c>
    # X-Frame-Options: 防止点击劫持
    Header always set X-Frame-Options "SAMEORIGIN"

    # X-Content-Type-Options: 防止 MIME 类型嗅探
    Header always set X-Content-Type-Options "nosniff"

    # X-XSS-Protection: 启用 XSS 过滤器
    Header always set X-XSS-Protection "1; mode=block"

    # Referrer-Policy: 控制 Referrer 信息
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions-Policy: 限制浏览器功能
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # 移除服务器版本信息
    Header always unset X-Powered-By
    Header always unset Server
</IfModule>

# ============================================
# 静态资源缓存配置
# ============================================
<IfModule mod_expires.c>
    ExpiresActive On

    # 图片缓存 1 年
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # 字体缓存 1 年
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"

    # CSS/JS 缓存 1 个月（带 hash 的文件可以更长）
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"

    # HTML 不缓存
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ============================================
# Gzip 压缩配置
# ============================================
<IfModule mod_deflate.c>
    # 启用压缩
    SetOutputFilter DEFLATE

    # 压缩等级
    DeflateCompressionLevel 6

    # 压缩类型
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json

    # 不压缩的图片
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp)$ no-gzip dont-vary
    SetEnvIfNoCase Request_URI \.(?:exe|t?gz|zip|bz2|sit|rar)$ no-gzip dont-vary
</IfModule>

# ============================================
# 禁用目录浏览
# ============================================
Options -Indexes

# ============================================
# 默认字符集
# ============================================
AddDefaultCharset UTF-8

# ============================================
# 自定义错误页面（可选）
# ============================================
# ErrorDocument 404 /404.html
# ErrorDocument 500 /500.html
