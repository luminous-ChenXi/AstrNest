# ============================================
# AstrNest 前端环境变量配置示例
# 复制此文件为 .env 或 .env.local 并根据实际情况修改
# ============================================

# API 基础地址
VITE_API_BASE_URL=http://localhost:8080

# 静态资源基础路径（CDN 配置）
# 如果使用 CDN，请设置为 CDN 地址，如：https://assets.yourdomain.com/
# 末尾必须带斜杠
VITE_ASSETS_BASE_URL=/

# 应用标题
VITE_APP_TITLE=AstrNest

# 应用版本
VITE_APP_VERSION=1.0.0
