# ============================================
# AstrNest 前端环境变量配置示例
# 复制此文件为 .env / .env.local / .env.production 并按需修改
# 所有 VITE_ 变量都是构建时注入，修改后需重新构建
# ============================================

# 后端 API 基础地址
# 留空 = 与前端同源（推荐，生产由 nginx 反代 /api；开发由 vite proxy 转发到 localhost:8081）
VITE_API_BASE_URL=

# 公共资源（上传文件）基础路径
VITE_PUBLIC_ASSET_BASE=/upload

# 站点名称（同时用于运行时覆盖页面标题）
VITE_SITE_NAME=AstrNest

# 静态资源基础路径（CDN 部署时使用，末尾必须带斜杠）
VITE_ASSETS_BASE_URL=/

# ---- 站点个性化（全部可选，未配置的板块/入口不会渲染）----
# ICP 备案号（如 "京ICP备XXXXXXXX号-X"），页脚 ICP 链接
VITE_ICP_NUMBER=
# 公安备案记录编号（纯数字 recordcode），页脚公安备案链接
VITE_BEIAN_RECORD_CODE=
# 站点上线日期（ISO 格式，如 2025-01-01），页脚"此站已运行"计时
VITE_SITE_BIRTHDAY=
# 页脚版权署名（如站点名或团队名）
VITE_SITE_COPYRIGHT=
# 联系邮箱（页脚"联系我们"与落地页邮件入口）
VITE_CONTACT_EMAIL=
# 帮助文档地址（认证页顶部"帮助文档"入口）
VITE_DOCS_URL=

# ---- 社交链接（全部可选，未配置的卡片不渲染）----
VITE_SOCIAL_GITHUB=
VITE_SOCIAL_DISCORD=
VITE_SOCIAL_X=
VITE_SOCIAL_BLOG=
VITE_SOCIAL_BILIBILI=
VITE_SOCIAL_QQ=
VITE_SOCIAL_GITEE=
VITE_SOCIAL_YOUTUBE=
