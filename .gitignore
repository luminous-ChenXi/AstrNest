/Demo/
/NapCatDocs-main/
/AstrNest-docs/
/.trae/

# 依赖目录
**/node_modules/
**/vendor/

# 构建输出
**/dist/
**/dist-ssr/
**/target/
**/build/

# 运行时存储与上传内容
/storage/

# 日志文件
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 环境变量文件（可能包含敏感信息）
.env
.env.local
.env.*.local
.env.development
.env.production

# Python 缓存与编译产物
__pycache__/
*.pyc
*.class

# 本地临时/私有文件
commit_msg.txt
.gitconfig_local

# 编辑器文件
.idea/
*.iws
*.iml
*.ipr
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 操作系统文件
.DS_Store
Thumbs.db

# 缓存文件
.cache/
*.cache

# 临时文件
*.tmp
*.temp
*.pid
*.seed
*.pid.lock

# 测试覆盖率
coverage/
.nyc_output/

# 数据库文件
*.db
*.sqlite
*.sqlite3

# 压缩文件
*.zip
*.tar.gz
*.rar
*.7z

# 其他
HELP.md
