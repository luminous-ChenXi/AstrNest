# =====================
# AstrNest Deployment Template
# Copy this file to .env (for docker-compose) and override every CHANGE_ME placeholder before running.
# =====================

# ---------- Database (MySQL container & backend JDBC) ----------
# 1. MYSQL_* 用于初始化 docker 中的 mysql:8.0 容器；若连接外部 MySQL，也请保持与实际实例一致。
# 2. ASTRNEST_DB_* 是 Spring Boot 连接数据库所需的 JDBC 地址与凭据，可与上方共用。
MYSQL_ROOT_PASSWORD=ChangeThisRootPass!
MYSQL_DATABASE=astrnest
MYSQL_USER=astrnest
MYSQL_PASSWORD=ChangeThisDbPass!

ASTRNEST_DB_URL=jdbc:mysql://mysql:3306/astrnest?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&rewriteBatchedStatements=true
ASTRNEST_DB_USERNAME=astrnest
ASTRNEST_DB_PASSWORD=ChangeThisDbPass!

# ---------- Security ----------
# JWT 签名密钥（生产必须设置，至少 32 字符）：生成方式 openssl rand -base64 48。
# 缺失时生产环境直接拒绝启动；开发环境用一次性随机密钥（重启全员掉线）
ASTRNEST_JWT_SECRET=

# 安装向导令牌（强烈建议）：设置后，安装向导的写操作必须携带 X-Chenxi-Install-Token 请求头，
# 防止部署窗口期被陌生人抢注管理员（前端安装页会要求填入；生成：openssl rand -hex 32；留空=不启用）
CHENXI_INSTALL_TOKEN=

# ---------- Storage ----------
ASTRNEST_STORAGE_ROOT=/var/lib/astrnest/upload
ASTRNEST_STORAGE_PUBLIC=/upload
ASTRNEST_STORAGE_STRATEGY=LOCAL

# ---------- Upload / Limits ----------
ASTRNEST_MULTIPART_MAX_FILE_SIZE=20MB
ASTRNEST_MULTIPART_MAX_REQUEST_SIZE=20MB
ASTRNEST_API_DEFAULT_QUOTA=1000
ASTRNEST_API_KEY_HEADER=X-API-Key

# ---------- JVM options ----------
JAVA_OPTS=-Xms512m -Xmx512m

# ---------- Administrator bootstrap ----------
# 本项目不预置任何管理员账号。首次部署请使用可视化安装向导（http://<your-host>:8081 或站点 /install），
# 或使用根目录 init-admin 脚本；未走向导时，第一个注册的用户会自动成为管理员。

# ---------- Site / Domain ----------
# 这些地址用于拼接对外链接：站点首页、图片直链、后端 API 域名，以及后端在生成图片 URL 时的 CDN/自定义域。
ASTRNEST_ASSET_DOMAIN=
PUBLIC_SITE_URL=https://your-domain.example
PUBLIC_ASSET_URL=https://your-domain.example/upload
BACKEND_API_PUBLIC_URL=https://api.your-domain.example

# ---------- Tencent Cloud AI Moderation (optional env fallback) ----------
# 若不希望在数据库中保存 Secret，可在此处填写，后端会在 system_config 缺值时读取这些环境变量。
ASTRNEST_AI_TENCENT_SECRET_ID=
ASTRNEST_AI_TENCENT_SECRET_KEY=
ASTRNEST_AI_TENCENT_REGION=ap-beijing
ASTRNEST_AI_TENCENT_BUCKET=your-bucket-1250000000
ASTRNEST_AI_TENCENT_DETECT_SCENES=web,camera,album,news
ASTRNEST_AI_BLOCK_CONFIDENCE=90
ASTRNEST_AI_REVIEW_CONFIDENCE=60
ASTRNEST_AI_LABEL_MIN_CONFIDENCE=60

# ---------- SMTP ----------
# 注意：后端 SMTP 配置存数据库（管理端「邮件设置」页，含发送测试），环境变量不生效；
# 此处保留注释仅作提醒。安装向导完成后请到管理端配置 SMTP。

# ---------- Frontend build (frontend/.env*) ----------
# Vite 变量是「构建时」注入：留空 = 与前端同源（推荐，nginx 反代 /api 与 /upload 即可）。
# docker compose 里设置的 VITE_* 运行时变量对已构建的静态文件无效。
VITE_API_BASE_URL=
VITE_PUBLIC_ASSET_BASE=
VITE_SITE_NAME=AstrNest

# ---------- SSO (external identity provider login, optional; disabled by default) ----------
# 兼容 OAuth 2.1 / OIDC「授权码 + PKCE」的外部身份源（如“辰汐通行证”，示例 issuer：https://passport.example.com）。
# 默认关闭；启用前需在身份源侧注册回调地址：https://<your-domain>/auth/sso/callback
ASTRNEST_SSO_ENABLED=false
ASTRNEST_SSO_ISSUER=
ASTRNEST_SSO_CLIENT_ID=
ASTRNEST_SSO_REDIRECT_URI=
